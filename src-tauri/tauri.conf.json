{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GitMint",
  "version": "1.1.1",
  "identifier": "com.gitmint.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "GitMint",
        "width": 1240,
        "height": 800,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": { "width": 760, "height": 500 },
        "appPosition": { "x": 190, "y": 300 },
        "applicationFolderPosition": { "x": 570, "y": 300 }
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
